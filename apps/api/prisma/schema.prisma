// FG One database schema.
// Multi-tenancy: every company-owned row carries organizationId and every
// query in the API is scoped by the organization of the authenticated session.
// See docs/DATABASE.md for the full model map (including later phases).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Tenancy & org structure ─────────────────────────────

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

model Organization {
  id             String             @id @default(cuid())
  name           String
  slug           String             @unique
  status         OrganizationStatus @default(ACTIVE)
  logoUrl        String?
  primaryColor   String             @default("#4f46e5")
  secondaryColor String             @default("#0ea5e9")
  /// Validated by organizationSettingsSchema in @fg/shared
  settings       Json               @default("{}")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  users               User[]
  departments         Department[]
  roles               Role[]
  invitations         Invitation[]
  auditLogs           AuditLog[]
  holidays            Holiday[]
  announcements       Announcement[]
  channels            Channel[]
  messages            Message[]
  sessions            Session[]
  attendance          AttendanceRecord[]
  notifications       Notification[]
  leaveTypes          LeaveType[]
  leaveRequests       LeaveRequest[]
  corrections         AttendanceCorrection[]
  permissionOverrides UserPermissionOverride[]
  superAdminInvites   SuperAdminInvitation[]
}

model Department {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  color          String       @default("#6366f1")
  headId         String?
  head           User?        @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  members       User[]         @relation("DepartmentMembers")
  announcements Announcement[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Role {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  name           String
  description    String?
  /// DEPRECATED (Phase 2a): no longer read or written. Grants live in RoleGrant. Dropped in Phase 4.
  permissions    String[]
  /// Higher rank may manage users of lower rank (super_admin=100, employee=10). Replaced by the ceiling rule in Phase 4.
  rank           Int          @default(10)
  isSystem       Boolean      @default(false)
  color          String?
  icon           String?
  templateKey    String?
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  users      User[]
  grants     RoleGrant[]
  extraUsers UserRole[]

  @@unique([organizationId, key])
}

// ───────────────────────────── People & identity ─────────────────────────────

enum UserStatus {
  INVITED
  ACTIVE
  /// Temporarily blocked; reversible. Cannot sign in.
  SUSPENDED
  DEACTIVATED
  /// Left the company; hidden from pickers. History is kept.
  ARCHIVED
}

enum AccountType {
  INTERNAL
  CLIENT
}

model User {
  id                  String       @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Company email, stored lower-case; globally unique so login can resolve the tenant.
  email               String       @unique
  passwordHash        String?
  /// Set when an admin sets the password; the user must choose their own before using the app
  mustChangePassword  Boolean      @default(false)
  status              UserStatus   @default(INVITED)
  accountType         AccountType  @default(INTERNAL)
  /// System authority, separate from roles. Changed only through /super-admins endpoints and operator CLIs.
  isSuperAdmin        Boolean      @default(false)
  /// TOTP secret, AES-256-GCM encrypted with MFA_ENCRYPTION_KEY. Set only after a code was verified.
  mfaSecretEnc        String?
  /// Secret awaiting its first verified code (enrolment in progress).
  mfaPendingSecretEnc String?
  mfaEnabledAt        DateTime?
  /// sha256 of unused one-time recovery codes.
  mfaRecoveryCodes    String[]     @default([])
  /// Last accepted TOTP time step; a code is never accepted twice.
  mfaLastStep         Int?
  roleId              String
  role                Role         @relation(fields: [roleId], references: [id])
  departmentId        String?
  department          Department?  @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)
  managerId           String?
  manager             User?        @relation("Reports", fields: [managerId], references: [id], onDelete: SetNull)
  reports             User[]       @relation("Reports")

  firstName    String
  lastName     String
  displayName  String?
  designation  String?
  employeeCode String?
  phone        String?
  pronouns     String?
  bio          String?
  avatarUrl    String?
  avatarColor  String    @default("#6366f1")
  timezone     String    @default("Asia/Kolkata")
  joinedAt     DateTime? @db.Date
  birthday     DateTime? @db.Date
  showBirthday Boolean   @default(true)
  /// Validated by userPreferencesSchema in @fg/shared
  preferences  Json      @default("{}")

  // Presence (temporary availability) — never used as an attendance record.
  presence        String    @default("available")
  statusEmoji     String?
  statusText      String?
  statusExpiresAt DateTime?
  lastSeenAt      DateTime?

  lastLoginAt   DateTime?
  failedLogins  Int       @default(0)
  lockedUntil   DateTime?
  deactivatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions              Session[]
  resetTokens           PasswordResetToken[]
  invitations           Invitation[]             @relation("InvitationUser")
  sentInvitations       Invitation[]             @relation("InvitationSender")
  headOfDepartments     Department[]             @relation("DepartmentHead")
  auditLogs             AuditLog[]
  announcements         Announcement[]
  channelsCreated       Channel[]
  memberships           ChannelMember[]
  messages              Message[]
  reactions             MessageReaction[]
  attendance            AttendanceRecord[]
  announcementAcks      AnnouncementAck[]
  notifications         Notification[]           @relation("NotificationUser")
  notificationsSent     Notification[]           @relation("NotificationActor")
  leaveRequests         LeaveRequest[]           @relation("LeaveRequester")
  leaveDecisions        LeaveRequest[]           @relation("LeaveApprover")
  corrections           AttendanceCorrection[]   @relation("CorrectionRequester")
  correctionReviews     AttendanceCorrection[]   @relation("CorrectionReviewer")
  extraRoles            UserRole[]
  superAdminInvites     SuperAdminInvitation[]   @relation("SuperAdminNominee")
  superAdminInvitesSent SuperAdminInvitation[]   @relation("SuperAdminInviter")
  permissionOverrides   UserPermissionOverride[]

  @@unique([organizationId, employeeCode])
  @@index([organizationId, status])
  @@index([organizationId, departmentId])
  @@index([managerId])
}

model Session {
  id              String       @id @default(cuid())
  /// sha256 of the opaque cookie token; the raw token is never stored
  tokenHash       String       @unique
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ip              String?
  userAgent       String?
  createdAt       DateTime     @default(now())
  lastSeenAt      DateTime     @default(now())
  expiresAt       DateTime
  /// Password accepted but the second step (TOTP or recovery code) is still owed. Such a session can only call /auth/mfa/verify and /auth/logout.
  mfaPending      Boolean      @default(false)
  mfaFailures     Int          @default(0)
  /// When the user last proved who they are (sign-in or re-authentication). Drives @RequireRecentAuth.
  authenticatedAt DateTime     @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("InvitationUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedById    String?
  invitedBy      User?        @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: SetNull)
  tokenHash      String       @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId        String?
  actor          User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action         String
  entityType     String
  entityId       String?
  metadata       Json         @default("{}")
  ip             String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
}

// ───────────────────────────── Company content (read in Phase 1, managed in Phase 4) ─────────────────────────────

/// MANDATORY = public holiday. SPECIAL_WORKING_DAY makes a normally off day a working day.
enum HolidayType {
  MANDATORY
  OPTIONAL
  COMPANY
  SPECIAL_WORKING_DAY
}

model Holiday {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  date           DateTime     @db.Date
  type           HolidayType  @default(MANDATORY)
  description    String?
  createdAt      DateTime     @default(now())

  @@unique([organizationId, date, name])
  @@index([organizationId, date])
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
  CRITICAL
}

enum AnnouncementCategory {
  COMPANY_NEWS
  IMPORTANT_UPDATE
  HOLIDAY
  NEW_FEATURE
  POLICY
  EVENT
  TEAM_UPDATE
  URGENT
}

model Announcement {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  authorId       String?
  author         User?                @relation(fields: [authorId], references: [id], onDelete: SetNull)
  /// null = company-wide; otherwise only visible to that department
  departmentId   String?
  department     Department?          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  title          String
  body           String
  priority       AnnouncementPriority @default(NORMAL)
  category       AnnouncementCategory @default(COMPANY_NEWS)
  requireAck     Boolean              @default(false)
  pinned         Boolean              @default(false)
  publishedAt    DateTime             @default(now())
  expiresAt      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  acks AnnouncementAck[]

  @@index([organizationId, publishedAt])
}

model AnnouncementAck {
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@id([announcementId, userId])
  @@index([userId])
}

// ───────────────────────────── Attendance (separate from presence) ─────────────────────────────

enum WorkLocation {
  WFO
  WFH
  ON_DUTY
}

model AttendanceRecord {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId             String
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Calendar day in the organization's time zone
  date               DateTime     @db.Date
  location           WorkLocation
  remarks            String?
  checkInAt          DateTime
  checkOutAt         DateTime?
  checkOutRemarks    String?
  /// Checked in after workday start + grace period
  late               Boolean      @default(false)
  /// Checked in by the portal (attendance.checkInMode = auto)
  autoCheckedIn      Boolean      @default(false)
  /// Set when the shift was closed automatically: workday_end | max_shift | idle
  autoCheckOutReason String?
  /// Last activity heartbeat from the portal, for the idle auto check-out rule
  lastActiveAt       DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  breaks AttendanceBreak[]

  @@unique([userId, date])
  @@index([organizationId, date])
  @@index([organizationId, checkOutAt])
}

enum AttendanceBreakKind {
  BREAK
  AWAY
}

model AttendanceBreak {
  id       String              @id @default(cuid())
  recordId String
  record   AttendanceRecord    @relation(fields: [recordId], references: [id], onDelete: Cascade)
  /// BREAK = a break; AWAY = time between check-out and checking in again the same day
  kind     AttendanceBreakKind @default(BREAK)
  startAt  DateTime
  endAt    DateTime?

  @@index([recordId])
}

// ───────────────────────────── Notifications ─────────────────────────────

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  actorId        String?
  actor          User?        @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  /// dm | mention | thread | announcement
  type           String
  title          String
  body           String?
  link           String?
  /// Unread notifications with the same key are merged (e.g. several DMs in one conversation)
  groupKey       String?
  count          Int          @default(1)
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([userId, groupKey])
}

// ───────────────────────────── Messaging ─────────────────────────────

enum ChannelType {
  PUBLIC
  PRIVATE
  DIRECT
}

enum ChannelMemberRole {
  ADMIN
  MEMBER
}

model Channel {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           ChannelType
  /// slug-style name for PUBLIC/PRIVATE; null for DIRECT
  name           String?
  description    String?
  topic          String?
  /// Sorted participant ids joined by ':' — guarantees one DM per participant set
  directKey      String?
  isDefault      Boolean      @default(false)
  createdById    String?
  createdBy      User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  archivedAt     DateTime?
  lastMessageAt  DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  members  ChannelMember[]
  messages Message[]

  @@unique([organizationId, name])
  @@unique([organizationId, directKey])
  @@index([organizationId, type])
}

model ChannelMember {
  channelId  String
  channel    Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       ChannelMemberRole @default(MEMBER)
  lastReadAt DateTime          @default(now())
  muted      Boolean           @default(false)
  joinedAt   DateTime          @default(now())

  @@id([channelId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channelId      String
  channel        Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId       String?
  author         User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body           String
  parentId       String?
  parent         Message?     @relation("Thread", fields: [parentId], references: [id], onDelete: SetNull)
  replies        Message[]    @relation("Thread")
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())

  reactions MessageReaction[]

  @@index([channelId, createdAt])
  @@index([organizationId, createdAt])
}

model MessageReaction {
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@id([messageId, userId, emoji])
}

// ───────────────────────────── Leave ─────────────────────────────

model LeaveType {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  code            String
  color           String       @default("#6366f1")
  /// Days per leave year; 0 = no limit (e.g. unpaid leave)
  annualAllowance Float        @default(0)
  paid            Boolean      @default(true)
  active          Boolean      @default(true)
  description     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  requests LeaveRequest[]

  @@unique([organizationId, code])
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum HalfDay {
  NONE
  FIRST_HALF
  SECOND_HALF
}

model LeaveRequest {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Cascade)
  typeId         String
  type           LeaveType    @relation(fields: [typeId], references: [id])
  startDate      DateTime     @db.Date
  endDate        DateTime     @db.Date
  halfDay        HalfDay      @default(NONE)
  /// Working days counted (weekends and holidays excluded), 0.5 for half days
  days           Float
  reason         String?
  status         LeaveStatus  @default(PENDING)
  approverId     String?
  approver       User?        @relation("LeaveApprover", fields: [approverId], references: [id], onDelete: SetNull)
  decisionNote   String?
  decidedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status])
  @@index([userId, startDate])
  @@index([organizationId, startDate, endDate])
}

// ───────────────────────────── Attendance corrections ─────────────────────────────

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

model AttendanceCorrection {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation("CorrectionRequester", fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime         @db.Date
  /// Requested times as local "HH:MM" in the organization time zone
  checkIn        String
  checkOut       String?
  location       WorkLocation
  reason         String
  status         CorrectionStatus @default(PENDING)
  reviewerId     String?
  reviewer       User?            @relation("CorrectionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewNote     String?
  decidedAt      DateTime?
  createdAt      DateTime         @default(now())

  @@index([organizationId, status])
  @@index([userId, date])
}

// ───────────────────────────── Authorization (Phase 2a) ─────────────────────────────

/// Data scope of a grant. Order for "widest wins": CLIENT < OWN < ASSIGNED < PROJECT < TEAM < DEPARTMENT < ORG.
enum PermissionScope {
  CLIENT
  OWN
  ASSIGNED
  PROJECT
  TEAM
  DEPARTMENT
  ORG
}

enum OverrideEffect {
  ALLOW
  DENY
}

/// One permission (from PERMISSION_CATALOG in @fg/shared) granted by a role at a scope.
model RoleGrant {
  id         String          @id @default(cuid())
  roleId     String
  role       Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission String
  scope      PermissionScope

  @@unique([roleId, permission])
}

/// Additional roles on top of the primary User.roleId.
model UserRole {
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedById String?
  createdAt    DateTime @default(now())

  @@id([userId, roleId])
  @@index([roleId])
}

/// Per-user exception. DENY removes the permission whatever the roles say; ALLOW adds it at `scope`.
model UserPermissionOverride {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission     String
  effect         OverrideEffect
  scope          PermissionScope?
  reason         String?
  grantedById    String?
  createdAt      DateTime         @default(now())

  @@unique([userId, permission])
  @@index([organizationId])
}

/// Nomination of an existing internal user to Super Admin. The nominee accepts with their password.
model SuperAdminInvitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("SuperAdminNominee", fields: [userId], references: [id], onDelete: Cascade)
  invitedById    String?
  invitedBy      User?        @relation("SuperAdminInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  tokenHash      String       @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([userId])
}
