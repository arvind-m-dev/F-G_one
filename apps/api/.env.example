# ── Core ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public URL of the web app (used in invite / reset links and CORS/origin checks)
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://fgone:CHANGE_ME@localhost:5432/fgone?schema=public

# Single-company mode: the organization served on the login page.
DEFAULT_ORG_SLUG=futurist-global

# ── Sessions ─────────────────────────────────────────
SESSION_COOKIE_NAME=fg_session
# Set to true behind HTTPS in production
COOKIE_SECURE=false
# Reverse-proxy hops whose X-Forwarded-For is trusted (local: 1, Render: 2). Used for rate limiting.
TRUST_PROXY=1
# Sign-in attempts per minute per IP (default 10). Raise only for local e2e runs.
# LOGIN_RATE_LIMIT_PER_MIN=10

# ── Email (invites & password reset) ─────────────────
# e.g. smtp://user:pass@smtp.example.com:587  (Mailpit from docker-compose: smtp://localhost:1025)
# Leave empty in development to print emails to the API console instead.
SMTP_URL=
MAIL_FROM="FG One <no-reply@futuristglobal.com>"

# ── Two-step verification ─────────────────────────────
# 32 random bytes that encrypt authenticator secrets: openssl rand -base64 32
# Required in production for two-step verification. Development falls back to a fixed local key.
# Changing it breaks every enrolled authenticator.
MFA_ENCRYPTION_KEY=

# ── Seed (development only) ──────────────────────────
# Password given to all seeded demo accounts. Required to run `pnpm db:seed`.
SEED_PASSWORD=
