{
  "name": "@fg/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm run sync-content && next dev -p 3000",
    "build": "pnpm run sync-content && next build",
    "sync-content": "node -e \"const fs=require('fs');const path=require('path');const src=path.join(__dirname,'..','..','docs','CHANGELOG.md');const dstDir=path.join(__dirname,'src','content');fs.mkdirSync(dstDir,{recursive:true});try{fs.copyFileSync(src,path.join(dstDir,'CHANGELOG.md'));}catch(e){console.warn('sync-content: changelog not found at',src);}\"",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fg/shared": "workspace:*",
    "@hookform/resolvers": "3.10.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/query-sync-storage-persister": "5.90.2",
    "@tanstack/react-query": "5.90.2",
    "@tanstack/react-query-persist-client": "5.90.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "0.577.0",
    "motion": "12.43.0",
    "next": "15.5.28",
    "next-themes": "0.4.6",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-hook-form": "^7.91.0",
    "recharts": "2.15.4",
    "socket.io-client": "4.8.4",
    "sonner": "2.0.7",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "1.3.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.1.13",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "tailwindcss": "4.1.13",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
